LC_ALL=C

DECODE='false'
URL='false'
PADDING='true'

ALPHABET_STANDARD=( {A..Z} {a..z} {0..9} + / )
ALPHABET_URL=( {A..Z} {a..z} {0..9} - _ )

block=()

fatal() {
	echo '[fatal]' "$@" >&2
	exit 1
}

emit-byte() {
	local byte=$1

	local hex
	printf -v hex '%02x' "$byte"
	printf '%b' "\\x$hex"
}

process-block-decode() {
	local len=${#block[@]}
	local s1=${block[0]}
	local s2=${block[1]}
	local s3=${block[2]}
	local s4=${block[3]}

	# input |  s1     s2     s3     s4
	#       | aaaaaa aabbbb bbbbcc cccccc
	#       |
	# n=    | 0000000aaaaaaaabbbbbbbbcccccccc
	#       |
	# output|    b1       b2       b3
	#       | aaaaaaaa bbbbbbbb cccccccc

	case "$len" in
		0)
			# no buffer, just return
			return
			;;
        1)
            # invalid padding, fail
            fatal 'Invalid block padding'
            ;;
		2)
            # restore padding by appending 2 '='
            s3=-1
            s4=-1
			;;
		3)
            # restore padding by appending 1 '='
            s4=-1
			;;
		4)
			# this is correct, do nothing
			;;
	esac

	if ((s1 < 0 || s2 < 0)); then
		fatal 'invalid base64 block'
	fi
	if ((s3 < 0 && s4 >= 0)); then
		fatal 'impossible base64 padding configuration'
	fi

	local bytes
	if ((s3 < 0)); then
		s3=0
		s4=0
		bytes=1
	elif ((s4 < 0)); then
		s4=0
		bytes=2
	else
		bytes=3
	fi

	local n=$(( (s1 << (6 * 3))
	          + (s2 << (6 * 2))
	          + (s3 << (6 * 1))
		  + (s4 << (6 * 0)) ))

	local b1=$(( (n >> (8 * 2)) & 2#11111111 ))
	local b2=$(( (n >> (8 * 1)) & 2#11111111 ))
	local b3=$(( (n >> (8 * 0)) & 2#11111111 ))

	case "$bytes" in
		1)
			emit-byte "$b1"
			;;
		2)
			emit-byte "$b1"
			emit-byte "$b2"
			;;
		3)
			emit-byte "$b1"
			emit-byte "$b2"
			emit-byte "$b3"
			;;
	esac

	block=()
}

process-byte-decode() {
	local byte=$1

	local value

	if (( (byte >= 9 && byte <= 13) || byte == 32 )); then
		# skip whitespace
		return
	elif ((byte == 61)); then
		# '='
		value=-1
	elif { $URL && (( byte == 45 )); } || { ! $URL && (( byte == 43 )); }; then
		# '+' (or '-' in Base64URL)
		value=62
	elif { $URL && (( byte == 95 )); } || { ! $URL && (( byte == 47 )); }; then
		# '/' (or '_' in Base64URL)
		value=63
	elif ((byte >= 65 && byte <= 90)); then
		# 'A' - 'Z'
		value=$((byte - 65))
	elif ((byte >= 97 && byte <= 122)); then
		# 'a' - 'z'
		value=$((byte - 71))
	elif ((byte >= 48 && byte <= 57)); then
		# '0' - '9'
		value=$((byte + 4))
	else
		fatal "invalid base64 byte: $byte"
	fi

	block+=("$value")

	if (( ${#block[@]} == 4 )); then
		process-block
	fi
}

emit-alpha() {
	local i=$1

    if $URL; then
        printf '%c' "${ALPHABET_URL[i]}"
    else
        printf '%c' "${ALPHABET_STANDARD[i]}"
    fi
}

process-block-encode() {
	local len=${#block[@]}
	local b1=${block[0]:-0}
	local b2=${block[1]:-0}
	local b3=${block[2]:-0}

	# input |    b1       b2       b3
	#       | aaaaaaaa bbbbbbbb cccccccc
	#       |
	# n=    | 0000000aaaaaaaabbbbbbbbcccccccc
	#       |
	# output|  s1     s2     s3     s4
	#       | aaaaaa aabbbb bbbbcc cccccc

	local n=$(( (b1 << (8 * 2))
	          + (b2 << (8 * 1))
		  + (b3 << (8 * 0)) ))

	local s1=$(( (n >> (6 * 3)) & 2#111111 ))
	local s2=$(( (n >> (6 * 2)) & 2#111111 ))
	local s3=$(( (n >> (6 * 1)) & 2#111111 ))
	local s4=$(( (n >> (6 * 0)) & 2#111111 ))

	case "$len" in
		0)
			;;
		1)
			emit-alpha "$s1"
			emit-alpha "$s2"
			$PADDING && printf '=='
			;;
		2)
			emit-alpha "$s1"
			emit-alpha "$s2"
			emit-alpha "$s3"
			$PADDING && printf '='
			;;
		3)
			emit-alpha "$s1"
			emit-alpha "$s2"
			emit-alpha "$s3"
			emit-alpha "$s4"
			;;
	esac

	block=()
}

process-block() {
	if $DECODE; then
		process-block-decode
	else
		process-block-encode
	fi
}

process-byte-encode() {
	local byte=$1

	block+=("$byte")

	if (( ${#block[@]} == 3 )); then
		process-block
	fi
}

process-byte() {
	local byte=$1

	if $DECODE; then
		process-byte-decode "$byte"
	else
		process-byte-encode "$byte"
	fi
}

process-input() {
	local chunk i c

	while true; do
		IFS= read -r -d '' -n 4096 chunk
		local code=$?
		local n=${#chunk}

		# loop the chunk and process byte-by-byte
		for ((i = 0; i < n; i++)); do
			c=${chunk:i:1}
			printf -v c '%d' "'$c"
			process-byte "$c"
		done

		# `read` failed - so we are done processing
		if ((code != 0)); then
			break
		fi

		# check for nul
		if ((n < 4096)); then
			process-byte 0
		fi
	done

	# drain the buffer
	process-block

	if ! $DECODE; then
		echo
	fi
}

main() {
	local OPTIND OPTARG opt
	while getopts 'dup' opt; do
		case "$opt" in
			d) DECODE='true';;
			u) URL='true';;
			p) PADDING='false';;
			*) return 2;;
		esac
	done
	shift "$((OPTIND - 1))"

	local file=${1:-/dev/stdin}
	process-input < "$file"
}

main "$@"
